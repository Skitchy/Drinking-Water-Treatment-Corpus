{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dwtc:schema:corpus-release-manifest:v0.1",
  "title": "Corpus Release Manifest v0.1",
  "description": "The corpus-side reproducibility anchor. It pins page content and the schemas, registries, and canonicalization procedures needed to interpret the release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "created_at",
    "profile_schema",
    "review_payload_canonicalization",
    "quote_normalization",
    "source_registry",
    "reviewer_registry",
    "coverage",
    "pages",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "corpus-release-manifest/v0.1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^corpus-release\\.[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_schema": {
      "$ref": "#/$defs/artifact"
    },
    "review_payload_canonicalization": {
      "$ref": "#/$defs/artifact"
    },
    "quote_normalization": {
      "$ref": "#/$defs/artifact"
    },
    "source_registry": {
      "$ref": "#/$defs/artifact"
    },
    "reviewer_registry": {
      "$ref": "#/$defs/artifact"
    },
    "coverage": {
      "$ref": "#/$defs/artifact"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_id",
          "content_sha256",
          "review_payload_sha256",
          "source_ids",
          "claim_ids",
          "quote_ids"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "content_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "review_payload_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^source\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
            }
          },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^claim\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
            }
          },
          "quote_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^quote\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$comment": "The manifest digest is calculated over canonical bytes excluding integrity.artifact_sha256. Semantic validation rejects duplicate IDs, page references missing from pinned registries, and artifact identifiers whose bytes do not match their pinned digest.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "artifact_sha256"
      ],
      "properties": {
        "canonicalization": {
          "const": "dw-corpus-release-manifest/v0.1"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
