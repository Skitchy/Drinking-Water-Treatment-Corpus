{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dwtc:schema:verified-answer:v0.1",
  "title": "Verified Answer Envelope v0.1",
  "description": "Closed, non-narrative gateway output. A conforming renderer resolves reviewed corpus IDs and deterministic templates; it never displays arbitrary model-authored prose from this object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "answer_id",
    "created_at",
    "outcome",
    "query",
    "corpus",
    "runtime",
    "applicability",
    "claim_refs",
    "quote_refs",
    "checks",
    "outcome_reasons",
    "renderer",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "verified-answer/v0.1"
    },
    "answer_id": {
      "type": "string",
      "pattern": "^answer\\.[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "evidence-backed",
        "evidence-only",
        "abstention"
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization_id",
        "sha256"
      ],
      "properties": {
        "canonicalization_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "$comment": "The query digest is an integrity fingerprint, not an anonymization boundary. The canonicalization artifact is pinned by the runtime assurance manifest."
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "manifest_sha256"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^corpus-release\\.[a-zA-Z0-9_-]+$"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_sha256"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "pattern": "^runtime-assurance\\.[a-zA-Z0-9_-]+$"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "use_class"
      ],
      "properties": {
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "use_class": {
          "const": "regulatory-reference"
        },
        "system_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_water_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "page_id",
          "review_payload_sha256"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^claim\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "page_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "review_payload_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "quote_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote_id",
          "page_id",
          "span_sha256"
        ],
        "properties": {
          "quote_id": {
            "type": "string",
            "pattern": "^quote\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "page_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "span_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "version",
          "verdict",
          "subjects"
        ],
        "properties": {
          "check_id": {
            "$ref": "#/$defs/checkId"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "not-run"
            ]
          },
          "subjects": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/subject"
            }
          }
        }
      }
    },
    "outcome_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "source_kind",
          "source_id",
          "subjects"
        ],
        "properties": {
          "code": {
            "$ref": "#/$defs/reasonCode"
          },
          "source_kind": {
            "enum": [
              "check",
              "policy-gate"
            ]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "subjects": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/subject"
            }
          }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_set_version"
      ],
      "properties": {
        "template_set_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "canonicalization",
        "artifact_sha256"
      ],
      "properties": {
        "mode": {
          "enum": [
            "validated",
            "signed"
          ]
        },
        "canonicalization": {
          "const": "dw-answer-envelope/v0.1"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "key_id",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "signed"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "signature"
            ],
            "properties": {
              "signature": {}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "evidence-backed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "verdict": {
                  "const": "pass"
                }
              }
            }
          },
          "outcome_reasons": {
            "type": "array",
            "maxItems": 0
          }
        },
        "anyOf": [
          {
            "properties": {
              "claim_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "quote_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "evidence-only"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "outcome_reasons": {
            "type": "array",
            "minItems": 1
          }
        },
        "anyOf": [
          {
            "properties": {
              "claim_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "quote_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "abstention"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "claim_refs": {
            "type": "array",
            "maxItems": 0
          },
          "quote_refs": {
            "type": "array",
            "maxItems": 0
          },
          "outcome_reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$comment": "Semantic validation is mandatory: both content-addressed manifests resolve and are mutually compatible; all IDs resolve in the named release; page, review-payload, span, and manifest digests match; the runtime manifest's required check matrix is complete for every envelope, page, claim kind, and quote; omission is failure; each outcome reason maps to a failing or not-run check or named policy gate; and the integrity digest matches canonical bytes. The digest canonicalization excludes integrity.artifact_sha256 and integrity.signature. Only a valid signature permits the label sealed. Auxiliary host-generated content is outside this envelope and its assurance claim.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkId": {
      "enum": [
        "schema",
        "corpus-release",
        "runtime-manifest",
        "eligibility",
        "claim-resolution",
        "quote-resolution",
        "span-fidelity",
        "numeric-claim-tuple",
        "derived-claim",
        "applicability",
        "freshness",
        "coverage"
      ]
    },
    "reasonCode": {
      "enum": [
        "OUT_OF_COVERAGE",
        "INSUFFICIENT_EVIDENCE",
        "STALE_EVIDENCE",
        "INELIGIBLE_EVIDENCE",
        "APPLICABILITY_UNRESOLVED",
        "RETRIEVAL_MISS",
        "CHECK_FAILED",
        "SOURCE_WATCH_FAILED",
        "SOURCE_CHANGE_PENDING",
        "SYNTHESIS_WITHHELD"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "envelope",
            "page",
            "claim",
            "quote"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
