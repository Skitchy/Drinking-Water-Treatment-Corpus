ABLE[1]/TR[16]/TD[1]","tag":"TD","text":""},{"col":2,"kind":"cell","row":16,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[16]/TD[2]","tag":"TD","text":"100,000-499,999"},{"col":3,"kind":"cell","row":16,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[16]/TD[3]","tag":"TD","text":"per quarter"},{"col":4,"kind":"cell","row":16,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[16]/TD[4]","tag":"TD","text":"6"},{"col":5,"kind":"cell","row":16,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[16]/TD[5]","tag":"TD","text":"3"},{"col":6,"kind":"cell","row":16,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[16]/TD[6]","tag":"TD","text":"2"},{"col":7,"kind":"cell","row":16,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[16]/TD[7]","tag":"TD","text":"1"}],"kind":"row","row":16,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[16]","tag":"TR"},{"children":[{"col":1,"kind":"cell","row":17,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[17]/TD[1]","tag":"TD","text":""},{"col":2,"kind":"cell","row":17,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[17]/TD[2]","tag":"TD","text":"≥500,000"},{"col":3,"kind":"cell","row":17,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[17]/TD[3]","tag":"TD","text":"per quarter"},{"col":4,"kind":"cell","row":17,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[17]/TD[4]","tag":"TD","text":"8"},{"col":5,"kind":"cell","row":17,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[17]/TD[5]","tag":"TD","text":"3"},{"col":6,"kind":"cell","row":17,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[17]/TD[6]","tag":"TD","text":"3"},{"col":7,"kind":"cell","row":17,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[17]/TD[7]","tag":"TD","text":"2"}],"kind":"row","row":17,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[17]","tag":"TR"},{"children":[{"col":1,"kind":"cell","row":18,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[18]/TD[1]","tag":"TD","text":"1 All systems must monitor during month of highest DBP concentrations."}],"kind":"row","row":18,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[18]","tag":"TR"},{"children":[{"col":1,"kind":"cell","row":19,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[19]/TD[1]","tag":"TD","text":"2 Systems on quarterly monitoring must take dual sample sets every 90 days at each monitoring location, except for subpart H systems serving 500-3,300. Ground water systems serving 500-9,999 on annual monitoring must take dual sample sets at each monitoring location. All other systems on annual monitoring and subpart H systems serving 500-3,300 are required to take individual TTHM and HAA5 samples (instead of a dual sample set) at the locations with the highest TTHM and HAA5 concentrations, respectively. For systems serving fewer than 500 people, only one location with a dual sample set per monitoring period is needed if the highest TTHM and HAA5 concentrations occur at the same location and month."}],"kind":"row","row":19,"selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]/TR[19]","tag":"TR"}],"kind":"table","selector":"DIV8[N=141.605]/DIV[1]/DIV[1]/TABLE[1]","tag":"TABLE"}],"kind":"other","selector":"DIV8[N=141.605]/DIV[1]/DIV[1]","tag":"DIV"}],"kind":"other","selector":"DIV8[N=141.605]/DIV[1]","tag":"DIV"},{"kind":"paragraph","selector":"DIV8[N=141.605]/P[3]","tag":"P","text":"(c) You must recommend subpart V compliance monitoring locations based on standard monitoring results, system specific study results, and subpart L compliance monitoring results. You must follow the protocol in paragraphs (c)(1) through (c)(8) of this section. If required to monitor at more than eight locations, you must repeat the protocol as necessary. If you do not have existing subpart L compliance monitoring results or if you do not have enough existing subpart L compliance monitoring results, you must repeat the protocol, skipping the provisions of paragraphs (c)(3) and (c)(7) of this section as necessary, until you have identified the required total number of monitoring locations."},{"kind":"paragraph","selector":"DIV8[N=141.605]/P[4]","tag":"P","text":"(1) Location with the highest TTHM LRAA not previously selected as a subpart V monitoring location."},{"kind":"paragraph","selector":"DIV8[N=141.605]/P[5]","tag":"P","text":"(2) Location with the highest HAA5 LRAA not previously selected as a subpart V monitoring location."},{"kind":"paragraph","selector":"DIV8[N=141.605]/P[6]","tag":"P","text":"(3) Existing subpart L average residence time compliance monitoring location (maximum residence time compliance monitoring location for ground water systems) with the highest HAA5 LRAA not previously selected as a subpart V monitoring location."},{"kind":"paragraph","selector":"DIV8[N=141.605]/P[7]","tag":"P","text":"(4) Location with the highest TTHM LRAA not previously selected as a subpart V monitoring location."},{"kind":"paragraph","selector":"DIV8[N=141.605]/P[8]","tag":"P","text":"(5) Location with the highest TTHM LRAA not previously selected as a subpart V monitoring location."},{"kind":"paragraph","selector":"DIV8[N=141.605]/P[9]","tag":"P","text":"(6) Location with the highest HAA5 LRAA not previously selected as a subpart V monitoring location."},{"kind":"paragraph","selector":"DIV8[N=141.605]/P[10]","tag":"P","text":"(7) Existing subpart L average residence time compliance monitoring location (maximum residence time compliance monitoring location for ground water systems) with the highest TTHM LRAA not previously selected as a subpart V monitoring location."},{"kind":"paragraph","selector":"DIV8[N=141.605]/P[11]","tag":"P","text":"(8) Location with the highest HAA5 LRAA not previously selected as a subpart V monitoring location."},{"kind":"paragraph","selector":"DIV8[N=141.605]/P[12]","tag":"P","text":"(d) You may recommend locations other than those specified in paragraph (c) of this section if you include a rationale for selecting other locations. If the State approves the alternate locations, you must monitor at these locations to determine compliance under subpart V of this part."},{"kind":"paragraph","selector":"DIV8[N=141.605]/P[13]","tag":"P","text":"(e) Your recommended schedule must include subpart V monitoring during the peak historical month for TTHM and HAA5 concentration, unless the State approves another month. Once you have identified the peak historical month, and if you are required to conduct routine monitoring at least quarterly, you must schedule subpart V compliance monitoring at a regular frequency of every 90 days or fewer."},{"kind":"citation","selector":"DIV8[N=141.605]/CITA[1]","tag":"CITA","text":"[71 FR 483, Jan. 4, 2006, as amended at 74 FR 30958, June 29, 2009]"}],"kind":"section","selector":"DIV8[N=141.605]","tag":"DIV8"}}
