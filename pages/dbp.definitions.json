    {
      "claim_id": "claim.dbp.definitions.chlorite-three-sample-set",
      "kind": "qualitative",
      "subject": "Chlorite routine monthly distribution-system monitoring",
      "relation": {
        "operator": "required",
        "regulatory_metric": "monitoring-trigger"
      },
      "value": "A three-sample set each month in the distribution system: one sample near the first customer, one at average residence time, one at maximum residence time",
      "conditions": [
        "The term three-sample set originates in the chlorite monitoring rule text at 141.132(b)(2), not in the general definitions at 141.2"
      ],
      "exceptions": [],
      "jurisdiction": "US-federal",
      "applicability": {
        "system_types": [
          "community-water-system",
          "nontransient-noncommunity-water-system",
          "transient-noncommunity-water-system"
        ],
        "conditions": [
          "Systems that use chlorine dioxide"
        ],
        "exclusions": []
      },
      "supporting_quote_ids": [
        "quote.dbp.definitions.three-sample-set"
      ]
    },
    {
      "claim_id": "claim.dbp.definitions.toc-paired-samples",
      "kind": "qualitative",
      "subject": "DBP precursor (TOC) routine monitoring samples",
      "relation": {
        "operator": "required",
        "regulatory_metric": "monitoring-trigger"
      },
      "value": "One paired sample (source water TOC prior to treatment and treated water TOC) plus one source water alkalinity sample per month per plant",
      "conditions": [
        "The term paired samples originates in the TOC monitoring rule text at 141.132(d), not in the general definitions at 141.2",
        "Field and guidance confusion trap: chlorite uses the monthly three-sample set; TOC uses monthly paired samples plus source alkalinity. EPA guidance 816-F-10-080 Table 3 uses the looser term TOC sample set for the latter"
      ],
      "exceptions": [],
      "jurisdiction": "US-federal",
      "applicability": {
        "system_types": [
          "community-water-system",
          "nontransient-noncommunity-water-system"
        ],
        "conditions": [
          "Systems using conventional filtration treatment (subpart H systems subject to 40 CFR 141.135)"
        ],
        "exclusions": []
