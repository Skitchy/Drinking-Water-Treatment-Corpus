  "claims": [
    {
      "claim_id": "claim.dbp.mrdl.chlorine-dioxide.mrdl",
      "kind": "numeric",
      "subject": "Maximum residual disinfectant level for chlorine dioxide",
      "relation": {
        "operator": "eq",
        "regulatory_metric": "mrdl"
      },
      "value": 0.8,
      "conditions": [
        "The 141.65(a) table lists chlorine, chloramines and chlorine dioxide together; this claim covers chlorine dioxide only, and the value is expressed as ClO2",
        "The MRDLG for chlorine dioxide is a separate value recorded on page dbp.mclg; it is not asserted here",
        "The residual-increase allowance of 141.130(d) names chlorine or chloramines and expressly excludes chlorine dioxide; no such allowance applies to this MRDL"
      ],
      "exceptions": [],
      "jurisdiction": "US-federal",
      "applicability": {
        "system_types": [
          "community-water-system",
          "nontransient-noncommunity-water-system",
          "transient-noncommunity-water-system"
        ],
        "conditions": [
          "Community, nontransient noncommunity, and transient noncommunity water systems that use chlorine dioxide for disinfection or oxidation (141.132(c)(2)(i), 141.130(a)(1)-(2))"
        ],
        "exclusions": [
          "Systems that do not use chlorine dioxide are not required to monitor for the chlorine dioxide residual"
        ]
      },
      "supporting_quote_ids": [
        "quote.dbp.mrdl.chlorine-dioxide.mrdl-table",
