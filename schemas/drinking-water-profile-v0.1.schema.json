{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dwtc:schema:drinking-water-profile:v0.1",
  "title": "Drinking Water Assurance Profile v0.1",
  "description": "Normalized JSON representation of an OKF concept page using the strict regulatory-reference assurance profile.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "page_id",
    "title",
    "status",
    "assurance_profile",
    "use_class",
    "jurisdiction",
    "applicability",
    "generated",
    "review_payload",
    "normalization",
    "verified",
    "stale_after",
    "source_watch",
    "source_refs",
    "quotes",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "drinking-water-profile/v0.1"
    },
    "type": {
      "const": "concept"
    },
    "page_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "assurance_profile": {
      "const": "drinking-water/v0.1"
    },
    "use_class": {
      "const": "regulatory-reference"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "$ref": "#/$defs/applicability"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "at"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "review_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "sha256"
      ],
      "properties": {
        "canonicalization": {
          "const": "dw-review-payload/v0.1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "$comment": "The canonicalization specification and conformance vectors must define included fields, exclusions, ordering, encoding, and newline handling."
    },
    "normalization": {
      "const": "dw-quote-normalization/v0.1"
    },
    "verified": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification"
      }
    },
    "stale_after": {
      "type": "string",
      "format": "date"
    },
    "source_watch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "watch_id",
        "last_result",
        "last_checked_at",
        "next_due_at"
      ],
      "properties": {
        "watch_id": {
          "type": "string",
          "pattern": "^watch\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "last_result": {
          "enum": [
            "unchanged",
            "changed",
            "failed",
            "not-run"
          ]
        },
        "last_checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "next_due_at": {
          "type": "string",
          "format": "date-time"
        },
        "change_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "last_result": {
                "const": "changed"
              }
            },
            "required": [
              "last_result"
            ]
          },
          "then": {
            "required": [
              "change_id"
            ],
            "properties": {
              "change_id": {}
            }
          }
        }
      ],
      "$comment": "This is a dated observation, not a live status. The reader derives effective status at evaluation time; now at or after next_due_at is overdue regardless of last_result."
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "captured_sha256",
          "licensing_decision_payload_sha256"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^source\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "captured_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "licensing_decision_payload_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quote"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "stable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_watch": {
            "type": "object",
            "properties": {
              "last_result": {
                "const": "unchanged"
              }
            }
          },
          "verified": {
            "type": "array",
            "minItems": 2
          },
          "quotes": {
            "type": "array",
            "minItems": 1
          },
          "claims": {
            "type": "array",
            "minItems": 1
          }
        },
        "allOf": [
          {
            "properties": {
              "verified": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "actor_type": {
                      "const": "process"
                    },
                    "scopes": {
                      "type": "array",
                      "allOf": [
                        {
                          "contains": {
                            "const": "source-capture"
                          }
                        },
                        {
                          "contains": {
                            "const": "quote-fidelity"
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "actor_type",
                    "scopes"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "verified": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "actor_type": {
                      "const": "human"
                    },
                    "scopes": {
                      "type": "array",
                      "allOf": [
                        {
                          "contains": {
                            "const": "editorial-accuracy"
                          }
                        },
                        {
                          "contains": {
                            "const": "applicability"
                          }
                        },
                        {
                          "contains": {
                            "const": "context-completeness"
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "actor_type",
                    "scopes"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": true,
  "$comment": "Unknown root fields remain permitted for OKF compatibility. Serving eligibility additionally requires semantic validation: verification digests equal the current review payload; human and process scopes are authorized; source references resolve to matching captured bytes and approved content-bound licensing decisions; quote source digests match those source records; IDs are unique; population bounds are ordered; derivations are acyclic and use registered algorithms; date formats and ordering are valid; effective watch status is derived from evaluation time and next_due_at; and every stable claim's support is within the recorded review scopes.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_types",
        "conditions"
      ],
      "properties": {
        "system_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_water_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 0
            },
            "maximum": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "actor_type",
        "at",
        "review_payload_sha256",
        "scopes"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "actor_type": {
          "enum": [
            "human",
            "process"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "review_payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source-capture",
              "quote-fidelity",
              "editorial-accuracy",
              "applicability",
              "context-completeness",
              "licensing"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "actor_type": {
                "const": "human"
              }
            },
            "required": [
              "actor_type"
            ]
          },
          "then": {
            "properties": {
              "scopes": {
                "type": "array",
                "items": {
                  "enum": [
                    "editorial-accuracy",
                    "applicability",
                    "context-completeness",
                    "licensing"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "scopes": {
                "type": "array",
                "items": {
                  "enum": [
                    "source-capture",
                    "quote-fidelity"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "source_id",
        "captured_source_sha256",
        "anchor",
        "normalization",
        "span_sha256",
        "verified_at"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "pattern": "^quote\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^source\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "captured_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selector_type",
            "selector_version",
            "value"
          ],
          "properties": {
            "selector_type": {
              "enum": [
                "text-position",
                "pdf-text-position",
                "json-pointer"
              ]
            },
            "selector_version": {
              "const": "v0.1"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "normalization": {
          "const": "dw-quote-normalization/v0.1"
        },
        "span_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "kind",
        "subject",
        "relation",
        "value",
        "jurisdiction",
        "applicability",
        "supporting_quote_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "numeric",
            "qualitative",
            "derived"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "regulatory_metric"
          ],
          "properties": {
            "operator": {
              "enum": [
                "eq",
                "lt",
                "lte",
                "gt",
                "gte",
                "range-inclusive",
                "required",
                "prohibited"
              ]
            },
            "regulatory_metric": {
              "enum": [
                "mcl",
                "mclg",
                "mrdl",
                "mrdlg",
                "action-level",
                "treatment-technique",
                "monitoring-trigger",
                "other"
              ]
            }
          }
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "boolean"
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_through": {
          "type": "string",
          "format": "date"
        },
        "supporting_quote_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^quote\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        },
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_claim_ids",
            "algorithm_id",
            "parameters",
            "rounding"
          ],
          "properties": {
            "input_claim_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^claim\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              }
            },
            "algorithm_id": {
              "type": "string",
              "pattern": "^algorithm\\.[a-z0-9]+(?:[._-][a-z0-9]+)*/v[0-9]+\\.[0-9]+$"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            },
            "rounding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "decimal_places"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "none",
                    "half-up",
                    "half-even",
                    "floor",
                    "ceiling"
                  ]
                },
                "decimal_places": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "numeric"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "unit"
            ],
            "properties": {
              "unit": {},
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "derived"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "derivation"
            ],
            "properties": {
              "derivation": {}
            }
          }
        }
      ]
    }
  }
}
