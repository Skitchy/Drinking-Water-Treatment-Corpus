      "kind": "qualitative",
      "subject": "Locational running annual average (LRAA)",
      "relation": {
        "operator": "eq",
        "regulatory_metric": "other"
      },
      "value": "Average of sample analytical results for samples taken at a particular monitoring location during the previous four calendar quarters",
      "conditions": [
        "Defined in 40 CFR 141.2; the general definitions section defines LRAA but contains no general definition of running annual average (RAA), which operates through the compliance computations in 141.133"
      ],
