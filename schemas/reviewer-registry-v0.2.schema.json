{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dwtc:schema:reviewer-registry:v0.2",
  "title": "Drinking Water Reviewer Registry v0.2",
  "description": "Registry for resolving stable human reviewer IDs, qualifications, authorization intervals, and content or procedure review scopes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "updated_at",
    "reviewers"
  ],
  "properties": {
    "schema_version": {
      "const": "reviewer-registry/v0.2"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "display_name",
          "status",
          "status_changed_at",
          "authorized_from",
          "qualifications",
          "review_scopes",
          "record_updated_at"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "pattern": "^human\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "active",
              "inactive",
              "suspended",
              "revoked"
            ]
          },
          "status_changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "authorized_from": {
            "type": "string",
            "format": "date-time"
          },
          "authorized_through": {
            "type": "string",
            "format": "date-time"
          },
          "qualifications": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "description",
                "jurisdiction",
                "valid_from",
                "evidence"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "operator-certification",
                    "professional-license",
                    "education",
                    "documented-experience",
                    "other"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "jurisdiction": {
                  "type": "string",
                  "minLength": 1
                },
                "valid_from": {
                  "type": "string",
                  "format": "date"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "expires_at": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          },
          "review_scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "editorial-accuracy",
                "applicability",
                "context-completeness",
                "licensing",
                "procedure-domain",
                "procedure-assurance"
              ]
            }
          },
          "scope_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "record_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "revocation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effective_at",
              "reason",
              "invalidates_prior_reviews"
            ],
            "properties": {
              "effective_at": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "invalidates_prior_reviews": {
                "type": "boolean"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "revoked"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "revocation": {}
              },
              "required": [
                "revocation"
              ]
            }
          }
        ]
      }
    }
  },
  "$comment": "v0.2 adds procedure-domain for clarification triggers, applicability judgment, and domain gotchas, plus procedure-assurance for transition mechanics, gateway and envelope alignment, and trace completeness. Semantic validation rejects duplicate reviewer IDs and review events outside the reviewer's authorization interval or supporting qualification validity period. Registry presence does not itself prove competence or independence."
}
