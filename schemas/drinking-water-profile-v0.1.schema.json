{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Skitchy/Drinking-Water-Treatment-Corpus/main/schemas/drinking-water-profile-v0.1.schema.json",
  "title": "Drinking Water Assurance Profile v0.1",
  "description": "Normalized JSON representation of an OKF concept page using the strict regulatory-reference assurance profile.",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "page_id",
    "title",
    "status",
    "assurance_profile",
    "use_class",
    "jurisdiction",
    "applicability",
    "generated",
    "review_payload",
    "normalization",
    "verified",
    "stale_after",
    "source_watch",
    "sources",
    "quotes",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "drinking-water-profile/v0.1"
    },
    "type": {
      "const": "concept"
    },
    "page_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "assurance_profile": {
      "const": "drinking-water/v0.1"
    },
    "use_class": {
      "const": "regulatory-reference"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "$ref": "#/$defs/applicability"
    },
    "generated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "at"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "review_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "sha256"
      ],
      "properties": {
        "canonicalization": {
          "const": "dw-review-payload/v0.1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "$comment": "The canonicalization specification and conformance vectors must define included fields, exclusions, ordering, encoding, and newline handling."
    },
    "normalization": {
      "const": "dw-quote-normalization/v0.1"
    },
    "verified": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification"
      }
    },
    "stale_after": {
      "type": "string",
      "format": "date"
    },
    "source_watch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "last_successful_at",
        "next_due_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "failed",
            "overdue",
            "change-pending"
          ]
        },
        "last_successful_at": {
          "type": "string",
          "format": "date-time"
        },
        "next_due_at": {
          "type": "string",
          "format": "date-time"
        },
        "change_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quote"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "stable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_watch": {
            "properties": {
              "status": {
                "const": "healthy"
              }
            }
          },
          "verified": {
            "minItems": 2
          },
          "quotes": {
            "minItems": 1
          },
          "claims": {
            "minItems": 1
          }
        },
        "allOf": [
          {
            "properties": {
              "verified": {
                "contains": {
                  "properties": {
                    "actor_type": {
                      "const": "process"
                    },
                    "scopes": {
                      "allOf": [
                        {
                          "contains": {
                            "const": "source-capture"
                          }
                        },
                        {
                          "contains": {
                            "const": "quote-fidelity"
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "actor_type",
                    "scopes"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "verified": {
                "contains": {
                  "properties": {
                    "actor_type": {
                      "const": "human"
                    },
                    "scopes": {
                      "allOf": [
                        {
                          "contains": {
                            "const": "editorial-accuracy"
                          }
                        },
                        {
                          "contains": {
                            "const": "applicability"
                          }
                        },
                        {
                          "contains": {
                            "const": "context-completeness"
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "actor_type",
                    "scopes"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ],
  "additionalProperties": true,
  "$comment": "Unknown root fields remain permitted for OKF compatibility. Serving eligibility additionally requires semantic validation: verification review_payload_sha256 values equal the current canonical payload digest; reviewer IDs resolve to active qualified registry entries; referenced source, quote, and claim IDs are unique and resolvable; dates are current under policy; and every stable claim's support is within the recorded review scopes.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_types",
        "conditions"
      ],
      "properties": {
        "system_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_water_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 0
            },
            "maximum": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by",
        "actor_type",
        "at",
        "review_payload_sha256",
        "scopes"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "actor_type": {
          "enum": [
            "human",
            "process"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "review_payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source-capture",
              "quote-fidelity",
              "editorial-accuracy",
              "applicability",
              "context-completeness",
              "licensing"
            ]
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "resource",
        "captured_at",
        "captured_sha256",
        "authority",
        "authenticity_evidence",
        "reproduction_basis"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^source\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "resource": {
          "type": "string",
          "format": "uri"
        },
        "published_at": {
          "type": "string",
          "format": "date"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_through": {
          "type": "string",
          "format": "date"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "captured_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority": {
          "enum": [
            "official-legal-record",
            "authoritative-unofficial-government-compilation",
            "agency-guidance",
            "licensed-technical-authority",
            "secondary-reference"
          ]
        },
        "authenticity_evidence": {
          "type": "string",
          "minLength": 1
        },
        "reproduction_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "evidence"
          ],
          "properties": {
            "classification": {
              "enum": [
                "public-domain-us-government-work",
                "express-license",
                "permission",
                "quotation-only",
                "excluded"
              ]
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "source_id",
        "captured_source_sha256",
        "anchor",
        "normalization",
        "span_sha256",
        "verified_at"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "pattern": "^quote\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "source_id": {
          "type": "string",
          "pattern": "^source\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "captured_source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "normalization": {
          "const": "dw-quote-normalization/v0.1"
        },
        "span_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "kind",
        "subject",
        "relation",
        "value",
        "jurisdiction",
        "applicability",
        "supporting_quote_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "numeric",
            "qualitative",
            "derived"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "boolean"
            }
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_through": {
          "type": "string",
          "format": "date"
        },
        "supporting_quote_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^quote\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        },
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_claim_ids",
            "expression",
            "rounding"
          ],
          "properties": {
            "input_claim_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^claim\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              }
            },
            "expression": {
              "type": "string",
              "minLength": 1
            },
            "rounding": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "numeric"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "unit"
            ],
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "derived"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "derivation"
            ]
          }
        }
      ]
    }
  }
}
