        "quote.dbp.violations.notification.appendix-a-notes-15-16",
        "quote.dbp.violations.notification.tier2-categories",
        "quote.dbp.violations.notification.tier3-categories",
        "quote.dbp.violations.notification.who-must-notify",
        "quote.dbp.violations.notification.subpart-l-scope"
      ]
    },
    {
      "claim_id": "claim.dbp.violations.notification.tier1-chlorine-dioxide",
      "kind": "qualitative",
      "subject": "The one DBP violation that requires a Tier 1 public notice",
      "relation": {
        "operator": "eq",
        "regulatory_metric": "other"
      },
      "value": "Violation of the chlorine dioxide MRDL when one or more samples taken in the distribution system the day after an exceedance at the entrance exceed the MRDL, or when the system does not take the required distribution system samples (141.133(c)(2)(i)); the system must also take immediate corrective action to lower chlorine dioxide below the MRDL",
      "conditions": [],
