  "claims": [
    {
      "claim_id": "claim.dbp.violations.notification.who-must-notify",
      "kind": "qualitative",
      "subject": "Who gives public notice of DBP violations",
      "relation": {
        "operator": "required",
        "regulatory_metric": "other"
      },
      "value": "Each owner or operator of a public water system (community, nontransient noncommunity and transient noncommunity) gives notice for all violations of national primary drinking water regulations, which include MCL, MRDL, treatment technique, monitoring and testing procedure violations; appendix A to subpart Q assigns the tier for each violation",
      "conditions": [],
      "exceptions": [],
      "jurisdiction": "US-federal",
      "applicability": {
        "system_types": [
          "community-water-system",
          "nontransient-noncommunity-water-system",
          "transient-noncommunity-water-system"
        ],
        "conditions": [
          "Every public water system gives notice for violations of national primary drinking water regulations, including MCL, MRDL, treatment technique, monitoring and testing procedure violations (141.201(a)); the DBP violations are those of subparts L, U and V as appendix A assigns them"
        ],
        "exclusions": []
      },
      "supporting_quote_ids": [
        "quote.dbp.violations.notification.who-must-notify",
        "quote.dbp.violations.notification.subpart-l-scope"
      ]
    },
    {
      "claim_id": "claim.dbp.violations.notification.tier-assignments-dbp",
      "kind": "qualitative",
      "subject": "Public notice tiers for DBP rule violations (appendix A to subpart Q)",
      "relation": {
        "operator": "eq",
        "regulatory_metric": "other"
      },
      "value": "MCL violations for TTHM, HAA5, bromate and chlorite, MRDL violations for chlorine and chloramine, chlorine dioxide MRDL violations where only two consecutive daily entrance samples are above the MRDL, and treatment technique violations for control of DBP precursors (TOC) are Tier 2; the chlorine dioxide MRDL violation where distribution system samples the next day are also above the MRDL is Tier 1; the monitoring and testing procedure violations under 141.132, 141.600 through 141.605 and 141.620 through 141.629 are Tier 3, except that failing to monitor for chlorine dioxide at the entrance the day after an entrance exceedance is Tier 2",
      "conditions": [
        "The primacy agency may determine that a Tier 1 notice is required for an MCL, MRDL or treatment technique violation, or a Tier 2 rather than Tier 3 notice for a monitoring or testing violation, taking into account potential health impacts and persistence (141.203(a), 141.204(a))"
      ],
      "exceptions": [],
      "jurisdiction": "US-federal",
      "applicability": {
        "system_types": [
          "community-water-system",
          "nontransient-noncommunity-water-system",
          "transient-noncommunity-water-system"
        ],
        "conditions": [
          "Every public water system gives notice for violations of national primary drinking water regulations, including MCL, MRDL, treatment technique, monitoring and testing procedure violations (141.201(a)); the DBP violations are those of subparts L, U and V as appendix A assigns them"
        ],
        "exclusions": []
      },
      "supporting_quote_ids": [
