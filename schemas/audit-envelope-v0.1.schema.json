{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dwtc:schema:audit-envelope:v0.1",
  "title": "Reader Audit Envelope v0.1",
  "description": "Minimal reproducibility record for retrieval, gating, generation, validation, and answer-envelope production.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "created_at",
    "query",
    "corpus",
    "runtime",
    "retrieval",
    "generation",
    "outcome",
    "checks",
    "answer_id"
  ],
  "properties": {
    "schema_version": {
      "const": "audit-envelope/v0.1"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^audit\\.[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization_id",
        "sha256",
        "normalized_query_retained",
        "expansions"
      ],
      "properties": {
        "canonicalization_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_query_retained": {
          "type": "boolean"
        },
        "normalized_query": {
          "type": "string"
        },
        "expansions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "normalized_query_retained": {
                "const": true
              }
            },
            "required": [
              "normalized_query_retained"
            ]
          },
          "then": {
            "required": [
              "normalized_query"
            ],
            "properties": {
              "normalized_query": {}
            }
          },
          "else": {
            "not": {
              "type": "object",
              "properties": {
                "normalized_query": {}
              },
              "required": [
                "normalized_query"
              ]
            }
          }
        }
      ]
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "manifest_sha256"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^corpus-release\\.[a-zA-Z0-9_-]+$"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_sha256"
      ],
      "properties": {
        "manifest_id": {
          "type": "string",
          "pattern": "^runtime-assurance\\.[a-zA-Z0-9_-]+$"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retriever_version",
        "candidates",
        "selected_page_ids"
      ],
      "properties": {
        "retriever_version": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page_id",
              "eligible",
              "score"
            ],
            "properties": {
              "page_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "eligible": {
                "type": "boolean"
              },
              "ineligibility_codes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "score": {
                "type": "number"
              }
            },
            "allOf": [
              {
                "if": {
                  "type": "object",
                  "properties": {
                    "eligible": {
                      "const": false
                    }
                  },
                  "required": [
                    "eligible"
                  ]
                },
                "then": {
                  "required": [
                    "ineligibility_codes"
                  ],
                  "properties": {
                    "ineligibility_codes": {
                      "type": "array",
                      "minItems": 1
                    }
                  }
                },
                "else": {
                  "properties": {
                    "ineligibility_codes": {
                      "type": "array",
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        },
        "selected_page_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_attempt",
        "attempts"
      ],
      "properties": {
        "accepted_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt",
              "response_sha256",
              "candidate_claim_ids",
              "candidate_quote_ids",
              "rejection_codes"
            ],
            "properties": {
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "response_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "candidate_claim_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^claim\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                }
              },
              "candidate_quote_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^quote\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
                }
              },
              "rejection_codes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "evidence-backed",
        "evidence-only",
        "abstention"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "version",
          "verdict",
          "subjects"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "not-run"
            ]
          },
          "subjects": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/subject"
            }
          },
          "reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "answer_id": {
      "type": "string",
      "pattern": "^answer\\.[a-zA-Z0-9_-]+$"
    }
  },
  "$comment": "The audit record must avoid unnecessary personal data. A plain query digest is an integrity fingerprint, not anonymization; retaining normalized text or expansions requires an explicit policy. Rejected attempts record only digests and structured rejection codes by default, never unchecked model prose. Semantic validation ensures both manifests resolve, selected pages are eligible candidates, accepted_attempt identifies exactly one recorded attempt, candidate references belong to selected pages, and the answer envelope agrees with this record.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "envelope",
            "page",
            "claim",
            "quote"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
