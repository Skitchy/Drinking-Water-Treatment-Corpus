{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Skitchy/Drinking-Water-Treatment-Corpus/main/schemas/verified-answer-v0.1.schema.json",
  "title": "Verified Answer Envelope v0.1",
  "description": "Closed, non-narrative gateway output. A conforming renderer resolves reviewed corpus IDs and deterministic templates; it never displays arbitrary model-authored prose from this object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "answer_id",
    "created_at",
    "outcome",
    "query_sha256",
    "corpus",
    "policy_version",
    "verifier_version",
    "applicability",
    "claim_refs",
    "quote_refs",
    "checks",
    "reason_codes",
    "renderer",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "verified-answer/v0.1"
    },
    "answer_id": {
      "type": "string",
      "pattern": "^answer\\.[a-zA-Z0-9_-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "evidence-backed",
        "evidence-only",
        "abstention"
      ]
    },
    "query_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "manifest_sha256"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "use_class"
      ],
      "properties": {
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "use_class": {
          "const": "regulatory-reference"
        },
        "system_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_water_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "page_id",
          "review_payload_sha256"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^claim\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "page_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "review_payload_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "quote_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote_id",
          "page_id",
          "span_sha256"
        ],
        "properties": {
          "quote_id": {
            "type": "string",
            "pattern": "^quote\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "page_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "span_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "version",
          "verdict",
          "claim_ids",
          "quote_ids"
        ],
        "properties": {
          "check_id": {
            "enum": [
              "schema",
              "corpus-release",
              "eligibility",
              "claim-resolution",
              "quote-resolution",
              "span-fidelity",
              "numeric-claim-tuple",
              "applicability",
              "freshness",
              "coverage"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "not-run"
            ]
          },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^claim\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
            }
          },
          "quote_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^quote\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "OUT_OF_COVERAGE",
          "INSUFFICIENT_EVIDENCE",
          "STALE_EVIDENCE",
          "INELIGIBLE_EVIDENCE",
          "APPLICABILITY_UNRESOLVED",
          "RETRIEVAL_MISS",
          "CHECK_FAILED",
          "SOURCE_WATCH_FAILED",
          "SOURCE_CHANGE_PENDING",
          "SYNTHESIS_WITHHELD"
        ]
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_set_version"
      ],
      "properties": {
        "template_set_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "canonicalization",
        "artifact_sha256"
      ],
      "properties": {
        "mode": {
          "enum": [
            "validated",
            "signed"
          ]
        },
        "canonicalization": {
          "const": "dw-answer-envelope/v0.1"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "key_id",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "signed"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "signature"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "evidence-backed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "minItems": 1,
            "items": {
              "properties": {
                "verdict": {
                  "const": "pass"
                }
              }
            }
          },
          "reason_codes": {
            "maxItems": 0
          }
        },
        "anyOf": [
          {
            "properties": {
              "claim_refs": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "quote_refs": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "evidence-only"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        },
        "anyOf": [
          {
            "properties": {
              "claim_refs": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "quote_refs": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "abstention"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "claim_refs": {
            "maxItems": 0
          },
          "quote_refs": {
            "maxItems": 0
          },
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$comment": "Semantic validation is mandatory: all IDs must resolve in the named immutable release; page, review-payload, span, and manifest digests must match; selected claims must be reviewed and eligible under policy; check references must be subsets of the envelope references; and the integrity digest must match canonical bytes. The digest canonicalization excludes integrity.artifact_sha256 and integrity.signature to avoid self-reference. Only a valid signature permits the label sealed. Auxiliary host-generated content is outside this envelope and outside its assurance claim.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
